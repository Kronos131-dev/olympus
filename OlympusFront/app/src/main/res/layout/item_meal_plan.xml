<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/plan_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/surface_container_low"
    app:cardCornerRadius="0dp"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:id="@+id/plan_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:fontFamily="@font/newsreader"
            android:text="Nom du plan"
            android:textColor="@color/marble_white"
            android:textSize="18sp"
            app:layout_constraintEnd_toStartOf="@id/btn_delete_plan"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/plan_recurrence"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/manrope"
            android:text="Récurrence"
            android:textColor="@color/secondary"
            android:textSize="11sp"
            app:layout_constraintEnd_toStartOf="@id/btn_delete_plan"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/plan_name" />

        <TextView
            android:id="@+id/plan_summary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/manrope"
            android:text="Détails"
            android:textColor="@color/outline_variant"
            android:textSize="11sp"
            app:layout_constraintEnd_toStartOf="@id/btn_delete_plan"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/plan_recurrence" />

        <ImageView
            android:id="@+id/btn_delete_plan"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="Supprimer"
            android:src="@android:drawable/ic_menu_delete"
            app:tint="#D81B60"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
