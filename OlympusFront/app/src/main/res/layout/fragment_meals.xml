<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <TextView
            android:id="@+id/meals_headline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/newsreader"
            android:text="@string/meals_title"
            android:textColor="@color/secondary"
            android:textSize="36sp"
            android:textStyle="bold|italic"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/meals_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/manrope"
            android:letterSpacing="0.1"
            android:text="@string/meals_subtitle"
            android:textColor="@color/outline_variant"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/meals_headline" />

        <EditText
            android:id="@+id/search_meals"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@color/surface_container_lowest"
            android:drawableStart="@android:drawable/ic_menu_search"
            android:drawablePadding="10dp"
            android:drawableTint="@color/outline_variant"
            android:fontFamily="@font/manrope"
            android:hint="Rechercher un repas…"
            android:inputType="text"
            android:maxLines="1"
            android:padding="14dp"
            android:textColor="@color/marble_white"
            android:textColorHint="@color/outline_variant"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@id/meal_actions" />

        <!-- Liste des repas pré-enregistrés -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_meals"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/search_meals" />

        <!-- Boutons de création de repas, placés en haut de la page. -->
        <LinearLayout
            android:id="@+id/meal_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/meals_subtitle">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/new_meal_button"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:fontFamily="@font/newsreader"
                android:text="@string/new_meal"
                android:textColor="@color/secondary"
                android:textSize="13sp"
                android:textStyle="bold"
                app:cornerRadius="0dp"
                app:strokeColor="@color/outline_variant" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/ai_meal_button"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:fontFamily="@font/newsreader"
                android:text="@string/ai_meal_button"
                android:textColor="@color/secondary"
                android:textSize="13sp"
                android:textStyle="bold"
                app:cornerRadius="0dp"
                app:strokeColor="@color/outline_variant" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>