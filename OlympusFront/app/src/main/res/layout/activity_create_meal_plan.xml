<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="Retour"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="@color/secondary" />

        <TextView
            android:id="@+id/screen_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/newsreader"
            android:text="CRÉER UN PLAN"
            android:textColor="@color/secondary"
            android:textSize="32sp"
            android:textStyle="bold|italic" />

        <EditText
            android:id="@+id/et_plan_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@color/surface_container_lowest"
            android:fontFamily="@font/manrope"
            android:hint="Nom du plan (ex: Semaine type)"
            android:inputType="text"
            android:padding="16dp"
            android:textColor="@color/marble_white"
            android:textColorHint="@color/outline_variant" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="@font/manrope"
            android:letterSpacing="0.1"
            android:text="RÉCURRENCE"
            android:textColor="@color/outline_variant"
            android:textSize="12sp" />

        <Spinner
            android:id="@+id/spinner_recurrence"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@color/surface_container_lowest"
            android:padding="8dp" />

        <LinearLayout
            android:id="@+id/container_weekdays"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <CheckBox
                android:id="@+id/cb_mon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/secondary"
                android:text="Lundi"
                android:textColor="@color/marble_white" />

            <CheckBox
                android:id="@+id/cb_tue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/secondary"
                android:text="Mardi"
                android:textColor="@color/marble_white" />

            <CheckBox
                android:id="@+id/cb_wed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/secondary"
                android:text="Mercredi"
                android:textColor="@color/marble_white" />

            <CheckBox
                android:id="@+id/cb_thu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/secondary"
                android:text="Jeudi"
                android:textColor="@color/marble_white" />

            <CheckBox
                android:id="@+id/cb_fri"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/secondary"
                android:text="Vendredi"
                android:textColor="@color/marble_white" />

            <CheckBox
                android:id="@+id/cb_sat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/secondary"
                android:text="Samedi"
                android:textColor="@color/marble_white" />

            <CheckBox
                android:id="@+id/cb_sun"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/secondary"
                android:text="Dimanche"
                android:textColor="@color/marble_white" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/container_custom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/manrope"
                android:text="Tous les "
                android:textColor="@color/marble_white" />

            <EditText
                android:id="@+id/et_custom_interval"
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:background="@color/surface_container_lowest"
                android:gravity="center"
                android:inputType="number"
                android:padding="12dp"
                android:text="2"
                android:textColor="@color/marble_white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/manrope"
                android:text=" jours"
                android:textColor="@color/marble_white" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="@font/manrope"
            android:letterSpacing="0.1"
            android:text="REPAS PLANIFIÉS"
            android:textColor="@color/outline_variant"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/entries_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_add_meal"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/manrope"
            android:text="+ AJOUTER UN REPAS"
            android:textColor="@color/secondary"
            app:cornerRadius="0dp"
            app:strokeColor="@color/outline_variant" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save_plan"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="32dp"
            android:backgroundTint="@color/secondary_container"
            android:fontFamily="@font/newsreader"
            android:text="ENREGISTRER LE PLAN"
            android:textColor="@color/on_secondary"
            android:textStyle="bold"
            app:cornerRadius="0dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
