<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <TextView
            android:id="@+id/subtitle_conquest"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/manrope"
            android:letterSpacing="0.1"
            android:text="@string/daily_conquest"
            android:textColor="@color/secondary"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/main_headline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/newsreader"
            android:text="@string/ledger_of_power"
            android:textColor="@color/marble_white"
            android:textSize="42sp"
            android:textStyle="bold|italic"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/subtitle_conquest" />

        <!-- Hero Progress Ring -->
        <FrameLayout
            android:id="@+id/progress_container"
            android:layout_width="280dp"
            android:layout_height="280dp"
            android:layout_marginTop="32dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/main_headline">

            <ProgressBar
                android:id="@+id/calories_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:indeterminate="false"
                android:max="2500"
                android:progress="0"
                android:progressDrawable="@drawable/ring_progress" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/manrope"
                    android:text="@string/consumed"
                    android:textColor="@color/secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/calories_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/newsreader"
                    android:text="0"
                    android:textColor="@color/marble_white"
                    android:textSize="48sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/calories_target_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/manrope"
                    android:text="@string/target_kcal"
                    android:textColor="@color/marble_white"
                    android:textSize="16sp" />
            </LinearLayout>
        </FrameLayout>

        <!-- Macros Section -->
        <LinearLayout
            android:id="@+id/macros_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:baselineAligned="false"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/progress_container">

            <!-- Protein -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ProgressBar
                    android:id="@+id/protein_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="80dp"
                    android:layout_height="4dp"
                    android:progress="0"
                    android:max="100"
                    android:progressTint="@color/primary_container" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/manrope"
                    android:text="@string/protein"
                    android:textColor="@color/marble_white"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/protein_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/newsreader"
                    android:text="0g"
                    android:textColor="@color/marble_white"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Carbs -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ProgressBar
                    android:id="@+id/carbs_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="80dp"
                    android:layout_height="4dp"
                    android:progress="0"
                    android:max="100"
                    android:progressTint="@color/secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/manrope"
                    android:text="@string/carbs"
                    android:textColor="@color/marble_white"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/carbs_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/newsreader"
                    android:text="0g"
                    android:textColor="@color/marble_white"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Fats -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ProgressBar
                    android:id="@+id/fats_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="80dp"
                    android:layout_height="4dp"
                    android:progress="0"
                    android:max="100"
                    android:progressTint="#D81B60" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/manrope"
                    android:text="@string/fats"
                    android:textColor="@color/marble_white"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/fats_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/newsreader"
                    android:text="0g"
                    android:textColor="@color/marble_white"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Buttons -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/add_meal_button"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="48dp"
            android:backgroundTint="@color/secondary_container"
            android:fontFamily="@font/newsreader"
            android:text="@string/add_meal"
            android:textColor="@color/on_secondary"
            android:textSize="18sp"
            android:textStyle="bold"
            app:cornerRadius="0dp"
            app:layout_constraintTop_toBottomOf="@id/macros_container" />

        <LinearLayout
            android:id="@+id/secondary_buttons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/add_meal_button">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/scan_barcode_button"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:fontFamily="@font/manrope"
                android:text="@string/scan_barcode"
                android:textColor="@color/secondary"
                android:textSize="12sp"
                app:cornerRadius="0dp"
                app:strokeColor="@color/outline_variant" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/manual_entry_button"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:fontFamily="@font/manrope"
                android:text="@string/manual_entry"
                android:textColor="@color/secondary"
                android:textSize="12sp"
                app:cornerRadius="0dp"
                app:strokeColor="@color/outline_variant" />
        </LinearLayout>

        <!-- Recent Provisions -->
        <TextView
            android:id="@+id/recent_provisions_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:fontFamily="@font/newsreader"
            android:text="@string/recent_provisions"
            android:textColor="@color/marble_white"
            android:textSize="24sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/secondary_buttons" />

        <!-- We replace the static layout with a RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_recent_logs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/recent_provisions_title" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>