<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <!-- Top Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/surface"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btn_close"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/outline_variant" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/newsreader"
            android:letterSpacing="0.2"
            android:text="OLYMPUS"
            android:textColor="@color/secondary"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/bottom_container"
        app:layout_constraintTop_toBottomOf="@id/top_bar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Title Section -->
            <TextView
                android:id="@+id/register_headline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/newsreader"
                android:text="CRÉATION\nDE COMPTE"
                android:textColor="@color/secondary"
                android:textSize="48sp"
                android:textStyle="bold" />

            <View
                android:layout_width="80dp"
                android:layout_height="4dp"
                android:layout_marginTop="12dp"
                android:background="@color/secondary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:fontFamily="@font/manrope"
                android:text="Renseignez vos informations pour générer votre profil métabolique et vos cibles nutritionnelles."
                android:textColor="@color/marble_white"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp" />

            <!-- LE GABARIT -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:fontFamily="@font/newsreader"
                android:letterSpacing="0.1"
                android:text="IDENTIFIANTS"
                android:textColor="@color/secondary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:background="@color/outline_variant"
                android:alpha="0.2" />

            <!-- Email -> Pseudo -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/manrope"
                android:letterSpacing="0.1"
                android:text="PSEUDO"
                android:textColor="@color/secondary"
                android:textSize="10sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_email"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="8dp"
                android:background="@color/surface_container_lowest"
                android:fontFamily="@font/newsreader"
                android:hint="pseudo"
                android:inputType="text"
                android:paddingHorizontal="16dp"
                android:textColor="@color/marble_white"
                android:textColorHint="@color/outline_variant"
                android:textSize="24sp"
                android:textStyle="italic" />

            <!-- Mot de passe -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/manrope"
                android:letterSpacing="0.1"
                android:text="MOT DE PASSE"
                android:textColor="@color/secondary"
                android:textSize="10sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_password"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="8dp"
                android:background="@color/surface_container_lowest"
                android:fontFamily="@font/newsreader"
                android:hint="••••••••"
                android:inputType="textPassword"
                android:paddingHorizontal="16dp"
                android:textColor="@color/marble_white"
                android:textColorHint="@color/outline_variant"
                android:textSize="24sp"
                android:textStyle="italic" />


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:fontFamily="@font/newsreader"
                android:letterSpacing="0.1"
                android:text="BIOMÉTRIE"
                android:textColor="@color/secondary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:background="@color/outline_variant"
                android:alpha="0.2" />

            <!-- Date de naissance -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/manrope"
                android:letterSpacing="0.1"
                android:text="DATE DE NAISSANCE"
                android:textColor="@color/secondary"
                android:textSize="10sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/et_birth_day"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:background="@color/surface_container_lowest"
                    android:fontFamily="@font/newsreader"
                    android:hint="JJ"
                    android:inputType="number"
                    android:gravity="center"
                    android:maxLength="2"
                    android:textColor="@color/marble_white"
                    android:textColorHint="@color/outline_variant"
                    android:textSize="24sp"
                    android:textStyle="italic" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:paddingHorizontal="8dp"
                    android:text="/"
                    android:textColor="@color/outline_variant"
                    android:textSize="24sp" />

                <EditText
                    android:id="@+id/et_birth_month"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:background="@color/surface_container_lowest"
                    android:fontFamily="@font/newsreader"
                    android:hint="MM"
                    android:inputType="number"
                    android:gravity="center"
                    android:maxLength="2"
                    android:textColor="@color/marble_white"
                    android:textColorHint="@color/outline_variant"
                    android:textSize="24sp"
                    android:textStyle="italic" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:paddingHorizontal="8dp"
                    android:text="/"
                    android:textColor="@color/outline_variant"
                    android:textSize="24sp" />

                <EditText
                    android:id="@+id/et_birth_year"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1.5"
                    android:background="@color/surface_container_lowest"
                    android:fontFamily="@font/newsreader"
                    android:hint="AAAA"
                    android:inputType="number"
                    android:gravity="center"
                    android:maxLength="4"
                    android:textColor="@color/marble_white"
                    android:textColorHint="@color/outline_variant"
                    android:textSize="24sp"
                    android:textStyle="italic" />
            </LinearLayout>

            <!-- Taille -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/manrope"
                android:letterSpacing="0.1"
                android:text="TAILLE (CM)"
                android:textColor="@color/secondary"
                android:textSize="10sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_height"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="8dp"
                android:background="@color/surface_container_lowest"
                android:fontFamily="@font/newsreader"
                android:hint="180"
                android:inputType="number"
                android:paddingHorizontal="16dp"
                android:textColor="@color/marble_white"
                android:textColorHint="@color/outline_variant"
                android:textSize="24sp"
                android:textStyle="italic" />

            <!-- Poids -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/manrope"
                android:letterSpacing="0.1"
                android:text="POIDS (KG)"
                android:textColor="@color/secondary"
                android:textSize="10sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et_weight"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="8dp"
                android:background="@color/surface_container_lowest"
                android:fontFamily="@font/newsreader"
                android:hint="85"
                android:inputType="numberDecimal"
                android:paddingHorizontal="16dp"
                android:textColor="@color/marble_white"
                android:textColorHint="@color/outline_variant"
                android:textSize="24sp"
                android:textStyle="italic" />

            <!-- Nature -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/manrope"
                android:letterSpacing="0.1"
                android:text="GENRE"
                android:textColor="@color/secondary"
                android:textSize="10sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_male"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/newsreader"
                    android:text="HOMME"
                    android:textColor="@color/secondary"
                    app:cornerRadius="0dp"
                    app:strokeColor="@color/outline_variant" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_female"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/newsreader"
                    android:text="FEMME"
                    android:textColor="@color/outline_variant"
                    app:cornerRadius="0dp"
                    app:strokeColor="@color/outline_variant" />
            </LinearLayout>

            <!-- LA VOCATION -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:fontFamily="@font/newsreader"
                android:letterSpacing="0.1"
                android:text="OBJECTIF"
                android:textColor="@color/secondary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:background="@color/outline_variant"
                android:alpha="0.2" />

            <!-- Option cards -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/ideal_card_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardBackgroundColor="@color/surface_container_low"
                app:cardCornerRadius="0dp"
                app:strokeColor="@color/secondary"
                app:strokeWidth="2dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/ideal_title_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/newsreader"
                        android:text="PRISE DE MASSE"
                        android:textColor="@color/marble_white"
                        android:textSize="20sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/manrope"
                        android:text="Surplus calorique (+10%)"
                        android:textColor="@color/outline_variant"
                        android:textSize="11sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/ideal_title_1" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@android:drawable/ic_menu_sort_by_size"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="@color/secondary" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/ideal_card_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/surface_container_lowest"
                app:cardCornerRadius="0dp"
                app:strokeWidth="0dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/ideal_title_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/newsreader"
                        android:text="PERTE DE POIDS"
                        android:textColor="@color/outline_variant"
                        android:textSize="20sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/manrope"
                        android:text="Déficit calorique (-15%)"
                        android:textColor="@color/outline_variant"
                        android:textSize="11sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/ideal_title_2" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@android:drawable/ic_menu_compass"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="@color/outline_variant" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/ideal_card_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/surface_container_lowest"
                app:cardCornerRadius="0dp"
                app:strokeWidth="0dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/ideal_title_3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/newsreader"
                        android:text="MAINTIEN"
                        android:textColor="@color/outline_variant"
                        android:textSize="20sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/manrope"
                        android:text="Stabilité (Aucun ajustement)"
                        android:textColor="@color/outline_variant"
                        android:textSize="11sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/ideal_title_3" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@android:drawable/ic_menu_preferences"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="@color/outline_variant" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/manrope"
                android:letterSpacing="0.1"
                android:text="NIVEAU D'ACTIVITÉ PHYSIQUE"
                android:textColor="@color/secondary"
                android:textSize="10sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinner_activity_level"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="8dp"
                android:background="@color/surface_container_lowest"
                android:paddingHorizontal="16dp"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Action -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottom_container"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="@color/surface"
        android:padding="24dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_register"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:backgroundTint="@color/secondary_container"
            android:fontFamily="@font/newsreader"
            android:text="S\'INSCRIRE"
            android:textColor="@color/on_secondary"
            android:textSize="18sp"
            android:textStyle="bold"
            app:cornerRadius="0dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>