<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <!-- En-tête : titre + sélecteur de fournisseur IA -->
    <TextView
        android:id="@+id/chat_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:fontFamily="@font/newsreader"
        android:text="ORACLE"
        android:textColor="@color/secondary"
        android:textSize="28sp"
        android:textStyle="bold|italic"
        app:layout_constraintBottom_toBottomOf="@id/btn_provider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/btn_provider" />

    <TextView
        android:id="@+id/btn_provider"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:background="@color/secondary_container"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/manrope"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp"
        android:text="Mistral"
        android:textColor="@color/on_secondary"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/chat_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="32dp"
        android:fontFamily="@font/manrope"
        android:gravity="center"
        android:text="Demandez conseil, décrivez un repas ou envoyez une photo : l'Oracle s'occupe du reste."
        android:textColor="@color/outline_variant"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="@id/recycler_chat"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/recycler_chat" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_chat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        app:layout_constraintBottom_toTopOf="@id/input_bar"
        app:layout_constraintTop_toBottomOf="@id/btn_provider" />

    <LinearLayout
        android:id="@+id/input_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_container_low"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageButton
            android:id="@+id/btn_mic"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            android:contentDescription="Dicter"
            android:src="@android:drawable/ic_btn_speak_now"
            app:tint="@color/secondary" />

        <ImageButton
            android:id="@+id/btn_photo"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            android:contentDescription="Photo"
            android:src="@android:drawable/ic_menu_camera"
            app:tint="@color/secondary" />

        <EditText
            android:id="@+id/et_message"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@color/surface_container_lowest"
            android:fontFamily="@font/manrope"
            android:hint="Votre message…"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="4"
            android:padding="12dp"
            android:textColor="@color/marble_white"
            android:textColorHint="@color/outline_variant" />

        <ImageButton
            android:id="@+id/btn_send"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            android:contentDescription="Envoyer"
            android:src="@android:drawable/ic_menu_send"
            app:tint="@color/secondary" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
