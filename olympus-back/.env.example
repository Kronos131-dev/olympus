# ---------------------------------------------------------------------------
# Modèle de configuration des secrets — À COPIER en `.env` (jamais versionné).
#
#   cp .env.example .env   puis renseigne les vraies valeurs.
#
# Le fichier `.env` est ignoré par git (cf .gitignore) : AUCUNE clé en clair
# ne doit jamais être commitée. docker-compose.prod.yml lit ce `.env`.
# ---------------------------------------------------------------------------

# --- Base de données PostgreSQL ---
POSTGRES_USER=olympus_user
POSTGRES_PASSWORD=change-me

# --- Agent IA « l'Oracle » ---
# Clé Mistral (obligatoire). Console : https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# Clé Google Gemini (optionnelle — vide = Gemini désactivé, Mistral par défaut).
GEMINI_API_KEY=
