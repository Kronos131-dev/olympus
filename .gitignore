# ===========================================================================
# Olympus — .gitignore unique pour le monorepo
# Backend : olympus-back (Java / Maven / Spring Boot)
# Frontend : OlympusFront (Android / Gradle)
# ===========================================================================

# --- Build / sorties de compilation ---
target/
build/
out/
bin/
*.class

# --- Maven ---
.mvn/wrapper/maven-wrapper.jar
release.properties
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next

# --- Gradle ---
.gradle/
gradle-app.setting
.gradletasknamecache

# --- Android ---
local.properties
*.apk
*.aab
*.ap_
*.aar
*.dex
captures/
.externalNativeBuild/
.cxx/
output.json
# Clés de signature — ne JAMAIS committer
*.jks
*.keystore

# --- IDE : IntelliJ IDEA / Android Studio ---
.idea/
*.iml
*.iws
*.ipr

# --- IDE : Eclipse / STS ---
.apt_generated/
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache/

# --- IDE : VS Code ---
.vscode/

# --- IDE : NetBeans ---
/nbproject/private/
/nbbuild/
/nbdist/
/.nb-gradle/

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Logs ---
*.log
logs/

# --- Secrets / configuration locale (overrides non versionnés) ---
.env
.env.local
application-local.yml
application-local.properties

# --- Divers ---
HELP.md
.claude/
